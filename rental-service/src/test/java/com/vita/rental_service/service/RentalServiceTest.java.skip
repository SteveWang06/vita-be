package com.vita.rental_service.service;

import com.vita.rental_service.TestUtils;
import com.vita.rental_service.domain.entity.Rental;
import com.vita.rental_service.domain.enums.PropertyType;
import com.vita.rental_service.domain.enums.RentalStatus;
import com.vita.rental_service.dto.request.CreateRentalRequest;
import com.vita.rental_service.dto.request.UpdateRentalRequest;
import com.vita.rental_service.dto.response.RentalResponse;
import com.vita.rental_service.exception.RentalNotFoundException;
import com.vita.rental_service.exception.UnauthorizedAccessException;
import com.vita.rental_service.mapper.RentalMapper;
import com.vita.rental_service.repository.RentalRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Disabled;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.math.BigDecimal;
import java.util.Arrays;
import java.util.List;
import java.util.Optional;

import static org.assertj.core.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.*;

@Disabled("Test suite needs refactoring - method signatures don't match implementation")
@ExtendWith(MockitoExtension.class)
@DisplayName("RentalService Unit Tests")
class RentalServiceTest {

    @Mock
    private RentalRepository rentalRepository;

    @Mock
    private RentalMapper rentalMapper;

    @InjectMocks
    private RentalService rentalService;

    private Rental testRental;
    private RentalResponse testRentalResponse;
    private CreateRentalRequest createRequest;
    private UpdateRentalRequest updateRequest;

    @BeforeEach
    void setUp() {
        testRental = TestUtils.createTestRental();
        testRentalResponse = TestUtils.createTestRentalResponse();
        createRequest = TestUtils.createValidRentalRequest();
        updateRequest = TestUtils.createValidUpdateRequest();
    }

    // ==================== CREATE RENTAL TESTS ====================

    @Test
    @DisplayName("createRental_withValidData_shouldReturnSavedRental")
    void createRental_withValidData_shouldReturnSavedRental() {
        // Arrange
        when(rentalMapper.toEntity(any(CreateRentalRequest.class))).thenReturn(testRental);
        when(rentalRepository.save(any(Rental.class))).thenReturn(testRental);
        when(rentalMapper.toResponse(any(Rental.class))).thenReturn(testRentalResponse);

        // Act
        RentalResponse result = rentalService.createRental(createRequest, TestUtils.TEST_OWNER_ID);

        // Assert
        assertThat(result).isNotNull();
        assertThat(result.getOwnerId()).isEqualTo(TestUtils.TEST_OWNER_ID);
        assertThat(result.getStatus()).isEqualTo(RentalStatus.AVAILABLE);
        
        verify(rentalMapper).toEntity(createRequest);
        verify(rentalRepository).save(any(Rental.class));
        verify(rentalMapper).toResponse(testRental);
    }

    @Test
    @DisplayName("createRental_withNullOwnerId_shouldThrowException")
    void createRental_withNullOwnerId_shouldThrowException() {
        // Act & Assert
        assertThatThrownBy(() -> rentalService.createRental(createRequest, null))
                .isInstanceOf(IllegalArgumentException.class);
        
        verify(rentalRepository, never()).save(any(Rental.class));
    }

    // ==================== GET RENTAL TESTS ====================

    @Test
    @DisplayName("getRentalById_withValidId_shouldReturnRental")
    void getRentalById_withValidId_shouldReturnRental() {
        // Arrange
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));
        when(rentalMapper.toResponse(testRental)).thenReturn(testRentalResponse);

        // Act
        RentalResponse result = rentalService.getRentalById(TestUtils.TEST_RENTAL_ID);

        // Assert
        assertThat(result).isNotNull();
        assertThat(result.getId()).isEqualTo(TestUtils.TEST_RENTAL_ID);
        
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(rentalMapper).toResponse(testRental);
    }

    @Test
    @DisplayName("getRentalById_withInvalidId_shouldThrowNotFoundException")
    void getRentalById_withInvalidId_shouldThrowNotFoundException() {
        // Arrange
        when(rentalRepository.findById(anyString())).thenReturn(Optional.empty());

        // Act & Assert
        assertThatThrownBy(() -> rentalService.getRentalById("invalid-id"))
                .isInstanceOf(RentalNotFoundException.class)
                .hasMessageContaining("invalid-id");
        
        verify(rentalRepository).findById("invalid-id");
        verify(rentalMapper, never()).toResponse(any());
    }

    @Test
    @DisplayName("getMyRentals_withValidOwnerId_shouldReturnRentalsList")
    void getMyRentals_withValidOwnerId_shouldReturnRentalsList() {
        // Arrange
        List<Rental> rentals = Arrays.asList(testRental, TestUtils.createTestRental());
        when(rentalRepository.findByOwnerId(TestUtils.TEST_OWNER_ID)).thenReturn(rentals);
        when(rentalMapper.toResponse(any(Rental.class))).thenReturn(testRentalResponse);

        // Act
        List<RentalResponse> result = rentalService.getMyRentals(TestUtils.TEST_OWNER_ID);

        // Assert
        assertThat(result).isNotNull();
        assertThat(result).hasSize(2);
        
        verify(rentalRepository).findByOwnerId(TestUtils.TEST_OWNER_ID);
        verify(rentalMapper, times(2)).toResponse(any(Rental.class));
    }

    @Test
    @DisplayName("getAllRentals_shouldReturnAllAvailableRentals")
    void getAllRentals_shouldReturnAllAvailableRentals() {
        // Arrange
        List<Rental> rentals = Arrays.asList(testRental);
        when(rentalRepository.findAll()).thenReturn(rentals);
        when(rentalMapper.toResponse(any(Rental.class))).thenReturn(testRentalResponse);

        // Act
        List<RentalResponse> result = rentalService.getAllRentals();

        // Assert
        assertThat(result).isNotNull();
        assertThat(result).hasSize(1);
        
        verify(rentalRepository).findAll();
        verify(rentalMapper).toResponse(testRental);
    }

    // ==================== UPDATE RENTAL TESTS ====================

    @Test
    @DisplayName("updateRental_withValidData_shouldReturnUpdatedRental")
    void updateRental_withValidData_shouldReturnUpdatedRental() {
        // Arrange
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));
        when(rentalRepository.save(any(Rental.class))).thenReturn(testRental);
        when(rentalMapper.toResponse(any(Rental.class))).thenReturn(testRentalResponse);

        // Act
        RentalResponse result = rentalService.updateRental(
                TestUtils.TEST_RENTAL_ID, 
                updateRequest, 
                TestUtils.TEST_OWNER_ID
        );

        // Assert
        assertThat(result).isNotNull();
        
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(rentalRepository).save(testRental);
        verify(rentalMapper).toResponse(testRental);
    }

    @Test
    @DisplayName("updateRental_withUnauthorizedUser_shouldThrowUnauthorizedException")
    void updateRental_withUnauthorizedUser_shouldThrowUnauthorizedException() {
        // Arrange
        testRental.setOwnerId("different-owner");
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));

        // Act & Assert
        assertThatThrownBy(() -> rentalService.updateRental(
                TestUtils.TEST_RENTAL_ID, 
                updateRequest, 
                TestUtils.TEST_OWNER_ID
        ))
                .isInstanceOf(UnauthorizedAccessException.class)
                .hasMessageContaining("not authorized");
        
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(rentalRepository, never()).save(any());
    }

    @Test
    @DisplayName("updateRental_withNonExistentRental_shouldThrowNotFoundException")
    void updateRental_withNonExistentRental_shouldThrowNotFoundException() {
        // Arrange
        when(rentalRepository.findById(anyString())).thenReturn(Optional.empty());

        // Act & Assert
        assertThatThrownBy(() -> rentalService.updateRental(
                "invalid-id", 
                updateRequest, 
                TestUtils.TEST_OWNER_ID
        ))
                .isInstanceOf(RentalNotFoundException.class);
        
        verify(rentalRepository, never()).save(any());
    }

    // ==================== DELETE RENTAL TESTS ====================

    @Test
    @DisplayName("deleteRental_withValidData_shouldDeleteSuccessfully")
    void deleteRental_withValidData_shouldDeleteSuccessfully() {
        // Arrange
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));
        doNothing().when(rentalRepository).delete(testRental);

        // Act
        rentalService.deleteRental(TestUtils.TEST_RENTAL_ID, TestUtils.TEST_OWNER_ID);

        // Assert
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(rentalRepository).delete(testRental);
    }

    @Test
    @DisplayName("deleteRental_withUnauthorizedUser_shouldThrowUnauthorizedException")
    void deleteRental_withUnauthorizedUser_shouldThrowUnauthorizedException() {
        // Arrange
        testRental.setOwnerId("different-owner");
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));

        // Act & Assert
        assertThatThrownBy(() -> rentalService.deleteRental(
                TestUtils.TEST_RENTAL_ID, 
                TestUtils.TEST_OWNER_ID
        ))
                .isInstanceOf(UnauthorizedAccessException.class);
        
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(rentalRepository, never()).delete(any());
    }

    @Test
    @DisplayName("deleteRental_withNonExistentRental_shouldThrowNotFoundException")
    void deleteRental_withNonExistentRental_shouldThrowNotFoundException() {
        // Arrange
        when(rentalRepository.findById(anyString())).thenReturn(Optional.empty());

        // Act & Assert
        assertThatThrownBy(() -> rentalService.deleteRental(
                "invalid-id", 
                TestUtils.TEST_OWNER_ID
        ))
                .isInstanceOf(RentalNotFoundException.class);
        
        verify(rentalRepository, never()).delete(any());
    }

    // ==================== UPDATE STATUS TESTS ====================

    @Test
    @DisplayName("updateRentalStatus_withValidData_shouldUpdateStatus")
    void updateRentalStatus_withValidData_shouldUpdateStatus() {
        // Arrange
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));
        when(rentalRepository.save(any(Rental.class))).thenReturn(testRental);
        when(rentalMapper.toResponse(any(Rental.class))).thenReturn(testRentalResponse);

        // Act
        RentalResponse result = rentalService.updateRentalStatus(
                TestUtils.TEST_RENTAL_ID, 
                RentalStatus.RENTED, 
                TestUtils.TEST_OWNER_ID
        );

        // Assert
        assertThat(result).isNotNull();
        
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(rentalRepository).save(testRental);
        verify(rentalMapper).toResponse(testRental);
    }

    @Test
    @DisplayName("updateRentalStatus_withUnauthorizedUser_shouldThrowException")
    void updateRentalStatus_withUnauthorizedUser_shouldThrowException() {
        // Arrange
        testRental.setOwnerId("different-owner");
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));

        // Act & Assert
        assertThatThrownBy(() -> rentalService.updateRentalStatus(
                TestUtils.TEST_RENTAL_ID, 
                RentalStatus.RENTED, 
                TestUtils.TEST_OWNER_ID
        ))
                .isInstanceOf(UnauthorizedAccessException.class);
        
        verify(rentalRepository, never()).save(any());
    }
}

