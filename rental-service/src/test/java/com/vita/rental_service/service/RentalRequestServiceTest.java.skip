package com.vita.rental_service.service;

import com.vita.rental_service.TestUtils;
import com.vita.rental_service.domain.entity.Rental;
import com.vita.rental_service.domain.entity.RentalRequest;
import com.vita.rental_service.domain.enums.RequestStatus;
import com.vita.rental_service.dto.request.CreateRentalRequestDto;
import com.vita.rental_service.dto.request.UpdateRequestStatusRequest;
import com.vita.rental_service.dto.response.RentalRequestResponse;
import com.vita.rental_service.exception.DuplicateRequestException;
import com.vita.rental_service.exception.RentalNotFoundException;
import com.vita.rental_service.exception.RentalRequestNotFoundException;
import com.vita.rental_service.exception.UnauthorizedAccessException;
import com.vita.rental_service.mapper.RentalRequestMapper;
import com.vita.rental_service.repository.RentalRepository;
import com.vita.rental_service.repository.RentalRequestRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Disabled;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.util.Arrays;
import java.util.List;
import java.util.Optional;

import static org.assertj.core.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.*;

@Disabled("Test suite needs major refactoring - methods signatures don't match implementation")
@ExtendWith(MockitoExtension.class)
@DisplayName("RentalRequestService Unit Tests")
class RentalRequestServiceTest {

    @Mock
    private RentalRequestRepository requestRepository;

    @Mock
    private RentalRepository rentalRepository;

    @Mock
    private RentalRequestMapper requestMapper;

    @InjectMocks
    private RentalRequestService rentalRequestService;

    private Rental testRental;
    private RentalRequest testRequest;
    private RentalRequestResponse testRequestResponse;
    private CreateRentalRequestDto createRequestDto;
    private UpdateRequestStatusRequest updateStatusRequest;

    @BeforeEach
    void setUp() {
        testRental = TestUtils.createTestRental();
        testRequest = TestUtils.createTestRentalRequest(TestUtils.TEST_RENTAL_ID, TestUtils.TEST_USER_ID);
        testRequestResponse = TestUtils.createTestRequestResponse();
        createRequestDto = TestUtils.createValidRentalRequestDto(TestUtils.TEST_RENTAL_ID);
        updateStatusRequest = TestUtils.createStatusUpdateRequest(RequestStatus.ACCEPTED);
    }

    // ==================== CREATE REQUEST TESTS ====================

    @Test
    @DisplayName("createRequest_withValidData_shouldReturnSavedRequest")
    void createRequest_withValidData_shouldReturnSavedRequest() {
        // Arrange
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));
        when(requestRepository.existsByRentalIdAndRenterIdAndStatus(
                anyString(), anyString(), any(RequestStatus.class)
        )).thenReturn(false);
        when(requestMapper.toEntity(any(CreateRentalRequestDto.class))).thenReturn(testRequest);
        when(requestRepository.save(any(RentalRequest.class))).thenReturn(testRequest);
        when(requestMapper.toResponse(any(RentalRequest.class))).thenReturn(testRequestResponse);

        // Act
        RentalRequestResponse result = rentalRequestService.createRequest(
                createRequestDto, 
                TestUtils.TEST_USER_ID
        );

        // Assert
        assertThat(result).isNotNull();
        assertThat(result.getRenterId()).isEqualTo(TestUtils.TEST_USER_ID);
        assertThat(result.getStatus()).isEqualTo(RequestStatus.PENDING);
        
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(requestRepository).existsByRentalIdAndRenterIdAndStatus(
                TestUtils.TEST_RENTAL_ID, 
                TestUtils.TEST_USER_ID, 
                RequestStatus.PENDING
        );
        verify(requestRepository).save(any(RentalRequest.class));
    }

    @Test
    @DisplayName("createRequest_withNonExistentRental_shouldThrowNotFoundException")
    void createRequest_withNonExistentRental_shouldThrowNotFoundException() {
        // Arrange
        when(rentalRepository.findById(anyString())).thenReturn(Optional.empty());

        // Act & Assert
        assertThatThrownBy(() -> rentalRequestService.createRequest(
                createRequestDto, 
                TestUtils.TEST_USER_ID
        ))
                .isInstanceOf(RentalNotFoundException.class);
        
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(requestRepository, never()).save(any());
    }

    @Test
    @DisplayName("createRequest_withDuplicatePendingRequest_shouldThrowDuplicateException")
    void createRequest_withDuplicatePendingRequest_shouldThrowDuplicateException() {
        // Arrange
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));
        when(requestRepository.existsByRentalIdAndRenterIdAndStatus(
                anyString(), anyString(), any(RequestStatus.class)
        )).thenReturn(true);

        // Act & Assert
        assertThatThrownBy(() -> rentalRequestService.createRequest(
                createRequestDto, 
                TestUtils.TEST_USER_ID
        ))
                .isInstanceOf(DuplicateRequestException.class)
                .hasMessageContaining("already have a pending request");
        
        verify(requestRepository, never()).save(any());
    }

    @Test
    @DisplayName("createRequest_withOwnerAsRenter_shouldThrowException")
    void createRequest_withOwnerAsRenter_shouldThrowException() {
        // Arrange
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));

        // Act & Assert
        assertThatThrownBy(() -> rentalRequestService.createRequest(
                createRequestDto, 
                TestUtils.TEST_OWNER_ID // Owner trying to rent their own property
        ))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessageContaining("cannot request your own rental");
        
        verify(requestRepository, never()).save(any());
    }

    // ==================== GET REQUEST TESTS ====================

    @Test
    @DisplayName("getRequestById_withValidId_shouldReturnRequest")
    void getRequestById_withValidId_shouldReturnRequest() {
        // Arrange
        String requestId = testRequest.getId();
        when(requestRepository.findById(requestId)).thenReturn(Optional.of(testRequest));
        when(requestMapper.toResponse(testRequest)).thenReturn(testRequestResponse);

        // Act
        RentalRequestResponse result = rentalRequestService.getRequestById(requestId);

        // Assert
        assertThat(result).isNotNull();
        assertThat(result.getId()).isEqualTo(requestId);
        
        verify(requestRepository).findById(requestId);
        verify(requestMapper).toResponse(testRequest);
    }

    @Test
    @DisplayName("getRequestById_withInvalidId_shouldThrowNotFoundException")
    void getRequestById_withInvalidId_shouldThrowNotFoundException() {
        // Arrange
        when(requestRepository.findById(anyString())).thenReturn(Optional.empty());

        // Act & Assert
        assertThatThrownBy(() -> rentalRequestService.getRequestById("invalid-id"))
                .isInstanceOf(RentalRequestNotFoundException.class);
        
        verify(requestRepository).findById("invalid-id");
    }

    @Test
    @DisplayName("getRequestsByRentalId_withValidRentalId_shouldReturnRequestsList")
    void getRequestsByRentalId_withValidRentalId_shouldReturnRequestsList() {
        // Arrange
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));
        List<RentalRequest> requests = Arrays.asList(testRequest);
        when(requestRepository.findByRentalId(TestUtils.TEST_RENTAL_ID)).thenReturn(requests);
        when(requestMapper.toResponse(any(RentalRequest.class))).thenReturn(testRequestResponse);

        // Act
        List<RentalRequestResponse> result = rentalRequestService.getRequestsByRentalId(
                TestUtils.TEST_RENTAL_ID, 
                TestUtils.TEST_OWNER_ID
        );

        // Assert
        assertThat(result).isNotNull();
        assertThat(result).hasSize(1);
        
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(requestRepository).findByRentalId(TestUtils.TEST_RENTAL_ID);
    }

    @Test
    @DisplayName("getRequestsByRentalId_withUnauthorizedUser_shouldThrowException")
    void getRequestsByRentalId_withUnauthorizedUser_shouldThrowException() {
        // Arrange
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));

        // Act & Assert
        assertThatThrownBy(() -> rentalRequestService.getRequestsByRentalId(
                TestUtils.TEST_RENTAL_ID, 
                "unauthorized-user"
        ))
                .isInstanceOf(UnauthorizedAccessException.class);
        
        verify(requestRepository, never()).findByRentalId(anyString());
    }

    @Test
    @DisplayName("getMyRequests_withValidRenterId_shouldReturnRequestsList")
    void getMyRequests_withValidRenterId_shouldReturnRequestsList() {
        // Arrange
        List<RentalRequest> requests = Arrays.asList(testRequest);
        when(requestRepository.findByRenterId(TestUtils.TEST_USER_ID)).thenReturn(requests);
        when(requestMapper.toResponse(any(RentalRequest.class))).thenReturn(testRequestResponse);

        // Act
        List<RentalRequestResponse> result = rentalRequestService.getMyRequests(TestUtils.TEST_USER_ID);

        // Assert
        assertThat(result).isNotNull();
        assertThat(result).hasSize(1);
        
        verify(requestRepository).findByRenterId(TestUtils.TEST_USER_ID);
    }

    // ==================== UPDATE STATUS TESTS ====================

    @Test
    @DisplayName("updateRequestStatus_withValidData_shouldUpdateStatus")
    void updateRequestStatus_withValidData_shouldUpdateStatus() {
        // Arrange
        when(requestRepository.findById(testRequest.getId())).thenReturn(Optional.of(testRequest));
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));
        when(requestRepository.save(any(RentalRequest.class))).thenReturn(testRequest);
        when(requestMapper.toResponse(any(RentalRequest.class))).thenReturn(testRequestResponse);

        // Act
        RentalRequestResponse result = rentalRequestService.updateRequestStatus(
                testRequest.getId(), 
                updateStatusRequest, 
                TestUtils.TEST_OWNER_ID
        );

        // Assert
        assertThat(result).isNotNull();
        
        verify(requestRepository).findById(testRequest.getId());
        verify(rentalRepository).findById(TestUtils.TEST_RENTAL_ID);
        verify(requestRepository).save(testRequest);
    }

    @Test
    @DisplayName("updateRequestStatus_withUnauthorizedUser_shouldThrowException")
    void updateRequestStatus_withUnauthorizedUser_shouldThrowException() {
        // Arrange
        when(requestRepository.findById(testRequest.getId())).thenReturn(Optional.of(testRequest));
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));

        // Act & Assert
        assertThatThrownBy(() -> rentalRequestService.updateRequestStatus(
                testRequest.getId(), 
                updateStatusRequest, 
                "unauthorized-user"
        ))
                .isInstanceOf(UnauthorizedAccessException.class);
        
        verify(requestRepository, never()).save(any());
    }

    @Test
    @DisplayName("updateRequestStatus_withNonPendingStatus_shouldThrowException")
    void updateRequestStatus_withNonPendingStatus_shouldThrowException() {
        // Arrange
        testRequest.setStatus(RequestStatus.ACCEPTED);
        when(requestRepository.findById(testRequest.getId())).thenReturn(Optional.of(testRequest));
        when(rentalRepository.findById(TestUtils.TEST_RENTAL_ID)).thenReturn(Optional.of(testRental));

        // Act & Assert
        assertThatThrownBy(() -> rentalRequestService.updateRequestStatus(
                testRequest.getId(), 
                updateStatusRequest, 
                TestUtils.TEST_OWNER_ID
        ))
                .isInstanceOf(IllegalStateException.class)
                .hasMessageContaining("only update status of PENDING requests");
        
        verify(requestRepository, never()).save(any());
    }

    // ==================== CANCEL REQUEST TESTS ====================

    @Test
    @DisplayName("cancelRequest_withValidData_shouldCancelSuccessfully")
    void cancelRequest_withValidData_shouldCancelSuccessfully() {
        // Arrange
        when(requestRepository.findById(testRequest.getId())).thenReturn(Optional.of(testRequest));
        when(requestRepository.save(any(RentalRequest.class))).thenReturn(testRequest);
        when(requestMapper.toResponse(any(RentalRequest.class))).thenReturn(testRequestResponse);

        // Act
        RentalRequestResponse result = rentalRequestService.cancelRequest(
                testRequest.getId(), 
                TestUtils.TEST_USER_ID
        );

        // Assert
        assertThat(result).isNotNull();
        
        verify(requestRepository).findById(testRequest.getId());
        verify(requestRepository).save(testRequest);
    }

    @Test
    @DisplayName("cancelRequest_withUnauthorizedUser_shouldThrowException")
    void cancelRequest_withUnauthorizedUser_shouldThrowException() {
        // Arrange
        when(requestRepository.findById(testRequest.getId())).thenReturn(Optional.of(testRequest));

        // Act & Assert
        assertThatThrownBy(() -> rentalRequestService.cancelRequest(
                testRequest.getId(), 
                "unauthorized-user"
        ))
                .isInstanceOf(UnauthorizedAccessException.class);
        
        verify(requestRepository, never()).save(any());
    }

    @Test
    @DisplayName("cancelRequest_withNonPendingStatus_shouldThrowException")
    void cancelRequest_withNonPendingStatus_shouldThrowException() {
        // Arrange
        testRequest.setStatus(RequestStatus.ACCEPTED);
        when(requestRepository.findById(testRequest.getId())).thenReturn(Optional.of(testRequest));

        // Act & Assert
        assertThatThrownBy(() -> rentalRequestService.cancelRequest(
                testRequest.getId(), 
                TestUtils.TEST_USER_ID
        ))
                .isInstanceOf(IllegalStateException.class)
                .hasMessageContaining("only cancel PENDING requests");
        
        verify(requestRepository, never()).save(any());
    }
}

